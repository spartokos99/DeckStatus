#include <winver.h>
#include "deckstatus_version.h"
#ifndef DECKSTATUS_BRIDGE
101 ICON "DeckStatus.ico"
#endif
1 VERSIONINFO
FILEVERSION DECKSTATUS_VERSION_RC
PRODUCTVERSION DECKSTATUS_VERSION_RC
FILEOS VOS_NT_WINDOWS32
#ifdef DECKSTATUS_BRIDGE
FILETYPE VFT_DLL
#else
FILETYPE VFT_APP
#endif
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "ProductName", "DeckStatus\0"
            VALUE "ProductVersion", DECKSTATUS_PRODUCT_VERSION_SZ
            VALUE "FileVersion", DECKSTATUS_FILE_VERSION_SZ
#ifdef DECKSTATUS_BRIDGE
            VALUE "FileDescription", "DeckStatus - Rekordbox data bridge\0"
            VALUE "InternalName", "DeckStatusBridge\0"
            VALUE "OriginalFilename", "DeckStatusBridge.dll\0"
#else
            VALUE "FileDescription", "DeckStatus - Live deck data and stream overlays\0"
            VALUE "InternalName", "DeckStatus\0"
            VALUE "OriginalFilename", "DeckStatus.exe\0"
#endif
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
