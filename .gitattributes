# Keep source and documentation portable; preserve Windows launcher line endings.
* text=auto eol=lf
*.hpp text eol=lf
# Preserve bundled dependencies verbatim without applying our whitespace policy.
/vendor/** -whitespace
*.cpp text eol=lf
*.h text eol=lf
*.js text eol=lf
*.cjs text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ps1 text eol=crlf
*.sln text eol=crlf
*.vcxproj text eol=crlf
*.png binary
*.ico binary
*.jpg binary
*.jpeg binary
